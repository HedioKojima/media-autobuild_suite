# Native MSYS2 clang64 toolchain file. No CMAKE_SYSTEM_NAME on purpose:
# this is a native Windows build, not a cross build.
SET(CMAKE_C_COMPILER clang)
SET(CMAKE_CXX_COMPILER clang++)
SET(CMAKE_RC_COMPILER llvm-windres)
SET(CMAKE_ASM_COMPILER clang)

SET(CMAKE_C_FLAGS_INIT "-O3 -march=@GCC_ARCH@ -ffunction-sections -fdata-sections")
SET(CMAKE_CXX_FLAGS_INIT "-O3 -march=@GCC_ARCH@ -ffunction-sections -fdata-sections")
SET(CMAKE_EXE_LINKER_FLAGS_INIT "-static -Wl,--gc-sections")

if("@ENABLE_CCACHE@" STREQUAL "ON")
    SET(CMAKE_C_COMPILER_LAUNCHER ccache)
    SET(CMAKE_CXX_COMPILER_LAUNCHER ccache)
endif()
