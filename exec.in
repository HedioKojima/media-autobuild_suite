#!/bin/bash
export PATH="$(cygpath -u "@MINGW_INSTALL_PREFIX@")/bin:/usr/bin:$PATH"
export PKG_CONFIG="pkgconf --static"
export PKG_CONFIG_LIBDIR="$(cygpath -u "@MINGW_INSTALL_PREFIX@")/lib/pkgconfig"
export CCACHE_DIR="@CCACHE_DIR@"

# MSYS2 ships /etc/config.site which points ac_aux_dir at the system automake
# directory; autotools projects then fail with "cannot find required auxiliary
# files: ... ltmain.sh config.rpath". Disable it for every package.
export CONFIG_SITE=/dev/null
# automake 在 Windows 绝对路径下会算丢盘符，额外给一条 posix 的 m4 搜索路径
export ACLOCAL_PATH=/usr/share/aclocal

export AR=llvm-ar
export NM=llvm-nm
export RANLIB=llvm-ranlib
export STRIP=llvm-strip
export WINDRES=llvm-windres
if [ "@ENABLE_CCACHE@" == "ON" ]; then
    export CC="ccache clang"
    export CXX="ccache clang++"
else
    export CC="clang"
    export CXX="clang++"
fi

eval "$@"
