[binaries]
c = [@MESON_CC@]
cpp = [@MESON_CXX@]
ar = 'llvm-ar'
strip = 'llvm-strip'
windres = 'llvm-windres'
pkg-config = 'pkgconf'
nasm = 'nasm'

[built-in options]
prefix = '@MINGW_INSTALL_PREFIX@'
libdir = 'lib'
buildtype = 'release'
# release 不会自动加 -DNDEBUG，b_ndebug 是独立选项；if-release 只在 release 下去 assert
b_ndebug = 'if-release'
default_library = 'static'
prefer_static = true
wrap_mode = 'nofallback'
c_args = ['-O3', '-march=@GCC_ARCH@', '-ffunction-sections', '-fdata-sections']
cpp_args = ['-O3', '-march=@GCC_ARCH@', '-ffunction-sections', '-fdata-sections']
c_link_args = ['-static', '-Wl,--gc-sections']
cpp_link_args = ['-static', '-Wl,--gc-sections']
